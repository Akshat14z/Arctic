# ConvoCart Environment Variables (Example)
# Copy to .env for local development

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Security & Sessions
SESSION_SECRET=dev_session_secret_min_32_characters_long_for_signing
AGENT_ACCESS_CODE=change-me

# Managed Backend Database (Supabase PostgreSQL)
# Pooler URL (for Fastify app runtime queries):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection URL (for Prisma CLI migrations):
DIRECT_URL="postgresql://postgres:[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase API & Storage (Optional / Server-side)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NexConn Cloud Credentials
NEXCONN_APP_KEY=your_nexconn_app_key_here
NEXCONN_APP_SECRET=your_nexconn_app_secret_here
NEXCONN_AREA=SG
# Regional API domains (Singapore data center: api.sg-light-api.com / api-b.sg-light-api.com)
NEXCONN_PRIMARY_API_DOMAIN=https://api.sg-light-api.com
NEXCONN_SECONDARY_API_DOMAIN=https://api-b.sg-light-api.com

# LLM Provider Configuration (Server only)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash
