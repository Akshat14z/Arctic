# ConvoCart Environment Variables (Example)
# Copy to .env for local development

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Security & Sessions
SESSION_SECRET=dev_session_secret_min_32_characters_long_for_signing
AGENT_ACCESS_CODE=convo_support_agent_2026

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample.region.neon.tech/convocart?sslmode=require

# NexConn Cloud Credentials
NEXCONN_APP_KEY=your_nexconn_app_key_here
NEXCONN_APP_SECRET=your_nexconn_app_secret_here
NEXCONN_AREA=SG

# LLM Provider Configuration (Server only)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash
